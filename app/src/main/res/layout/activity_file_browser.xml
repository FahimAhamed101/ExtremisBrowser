<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome_page_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Extremis.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/file_browser" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chrome_outline" />

    <!-- Current path, tappable to jump up a level -->
    <LinearLayout
        android:id="@+id/pathBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/chrome_list_row_height"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/chrome_gutter"
        android:paddingEnd="@dimen/chrome_gutter">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_folder_24" />

        <TextView
            android:id="@+id/pathText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/chrome_text"
            android:textSize="14sp"
            tools:text="/storage/emulated/0/Download" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chrome_outline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filesRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.5"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder_24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/empty_folder"
                android:textColor="@color/chrome_muted"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Only shown when the browser was opened to pick a download folder -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/selectFolderButton"
        style="@style/Widget.Extremis.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="@dimen/chrome_gutter"
        android:text="@string/select_folder"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ splash screen: Chrome-style white splash with the app mark. -->
    <style name="Theme.ExtremisBrowser" parent="Theme.ExtremisBrowser.Base">
        <item name="android:windowSplashScreenBackground">@color/chrome_page_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/chrome_page_bg</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome omnibox when focused: lifts to a white surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chrome_card_bg" />
    <corners android:radius="@dimen/chrome_omnibox_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/chrome_outline" />
</shape>
